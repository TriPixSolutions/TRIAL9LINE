# Database configuration
# In production / local PostgreSQL: postgresql://postgres:postgres@localhost:5432/trail9ine
# For lightweight zero-dependency local dev: file:./local-dev.db
DATABASE_URI=file:./local-dev.db

# Payload CMS Secret (Required - use a secure 32+ char string in production)
PAYLOAD_SECRET=placeholder-payload-secret-32-character-minimum-trail9ine-key

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Transactional Email (Resend)
RESEND_API_KEY=
RESEND_SENDER_EMAIL="TRAIL9INE MEDIA <inquiries@trail9ine.com>"
BUSINESS_NOTIFICATION_EMAIL=inquiries@trail9ine.com
RESEND_WEBHOOK_SECRET=

# Durable S3 Media Storage (Optional for local dev, uses local storage if unset)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Scheduled Worker Authorization Secret
WORKER_AUTH_SECRET=


# MongoDB Atlas: replace DATABASE_URI above with your complete connection string.
# DATABASE_URI=mongodb+srv://USER:PASSWORD@CLUSTER/trail9ine?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Enable only for an isolated SQLite development database when applying schema changes.
PAYLOAD_SCHEMA_PUSH=false
# Explicit development/test email simulation. Never enabled in production.
EMAIL_SIMULATION=false
