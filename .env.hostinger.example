# Add these through Hostinger's environment-variable settings, before building.
# Never upload or commit a completed environment file.
HOSTING_TARGET=hostinger
NODE_ENV=production
DATABASE_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/trail9ine?retryWrites=true&w=majority
PAYLOAD_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WORKER_AUTH_SECRET=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SERVER_URL=https://YOUR_DEPLOYED_DOMAIN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=inquiries@YOUR_VERIFIED_DOMAIN
RESEND_SENDER_EMAIL="Trail9ine Media <inquiries@YOUR_VERIFIED_DOMAIN>"
BUSINESS_NOTIFICATION_EMAIL=inquiries@YOUR_BUSINESS_DOMAIN
RESEND_WEBHOOK_SECRET=
PAYLOAD_SCHEMA_PUSH=false
EMAIL_SIMULATION=false
# Hostinger assigns PORT. Do not set a custom port here.
